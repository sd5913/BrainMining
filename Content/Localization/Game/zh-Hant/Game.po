msgstr "新增待辦"

msgctxt "BrainMining.Game,Office.Popup.00.Body"
msgid "21天gamejam游戏创作主题公布！"
msgstr "21 天 Game Jam 遊戲創作主題公布！"

msgctxt "BrainMining.Game,Office.Popup.00.Title"
msgid "Game Jam · 主题公布"
msgstr "Game Jam · 主題公布"

msgctxt "BrainMining.Game,Office.Popup.01.Body"
msgid "【涌现】"
msgstr "【湧現】"

msgctxt "BrainMining.Game,Office.Popup.01.Title"
msgid "21天 GAME JAM · 主题发布页"
msgstr "21 天 GAME JAM · 主題發布頁"

msgctxt "BrainMining.Game,Office.Popup.02.Body"
msgid "题目出来了。\n「涌现」……你们有什么想法？"
msgstr "題目出來了。\n「湧現」……你們有什麼想法？"

msgctxt "BrainMining.Game,Office.Popup.02.Title"
msgid "组队群 · 2条新消息"
msgstr "組隊群 · 2 則新訊息"

msgctxt "BrainMining.Game,Office.Popup.03.Body"
msgid "@你 玩法草案放文档里了。\n有空看下，晚上一起定。"
msgstr "@你 玩法草案放文件裡了。\n有空看一下，晚上一起定。"

msgctxt "BrainMining.Game,Office.Popup.03.Title"
msgid "共享文档 · 有人提到了你"
msgstr "共用文件 · 有人提到了你"

msgctxt "BrainMining.Game,Office.Popup.04.Body"
msgid "主题讨论会将在5分钟后开始。\n3位成员已加入。"
msgstr "主題討論會將在 5 分鐘後開始。\n3 位成員已加入。"

msgctxt "BrainMining.Game,Office.Popup.04.Title"
msgid "会议提醒"
msgstr "會議提醒"

msgctxt "BrainMining.Game,Office.Popup.05.Body"
msgid "检测到较新的云端版本。\n是否加载其他成员的修改？"
msgstr "偵測到較新的雲端版本。\n是否載入其他成員的修改？"

msgctxt "BrainMining.Game,Office.Popup.05.Title"
msgid "企划草案.docx"
msgstr "企劃草案.docx"

msgctxt "BrainMining.Game,Office.Popup.06.Body"
msgid "先做一个能玩的版本吧。\n剩下几个点子放备选。"
msgstr "先做一個能玩的版本吧。\n剩下幾個點子放備選。"

msgctxt "BrainMining.Game,Office.Popup.06.Title"
msgid "组队群 · 新消息"
msgstr "組隊群 · 新訊息"

msgctxt "BrainMining.Game,Office.Popup.07.Body"
msgid "任务「角色移动」已指派给你。\n截止时间：明天18:00。"
msgstr "任務「角色移動」已指派給你。\n截止時間：明天 18:00。"

msgctxt "BrainMining.Game,Office.Popup.07.Title"
msgid "任务已分配给你"
msgstr "任務已分配給你"

msgctxt "BrainMining.Game,Office.Popup.08.Body"
msgid "角色移动、物品交互、新手引导。\n还有3项任务未完成。"
msgstr "角色移動、物品互動、新手引導。\n還有 3 項任務未完成。"

msgctxt "BrainMining.Game,Office.Popup.08.Title"
msgid "To-do List · 今日到期"
msgstr "To-do List · 今日到期"

msgctxt "BrainMining.Game,Office.Popup.09.Body"
msgid "进度同步会已开始。\n主持人正在等待你加入。"
msgstr "進度同步會已開始。\n主持人正在等待你加入。"

msgctxt "BrainMining.Game,Office.Popup.09.Title"
msgid "会议提醒"
msgstr "會議提醒"

msgctxt "BrainMining.Game,Office.Popup.10.Body"
msgid "场景素材.zip 已下载。\n新增24个文件，替换6个文件。"
msgstr "場景素材.zip 已下載。\n新增 24 個檔案，取代 6 個檔案。"

msgctxt "BrainMining.Game,Office.Popup.10.Title"
msgid "资源同步完成"
msgstr "資源同步完成"

msgctxt "BrainMining.Game,Office.Popup.11.Body"
msgid "音效发群文件了。\n按钮和脚步声记得接一下。"
msgstr "音效放群組檔案了。\n按鈕和腳步聲記得接一下。"

msgctxt "BrainMining.Game,Office.Popup.11.Title"
msgid "组队群 · 新消息"
msgstr "組隊群 · 新訊息"

msgctxt "BrainMining.Game,Office.Popup.12.Body"
msgid "游戏引擎意外退出。\n是否恢复上次自动保存的项目？"
msgstr "遊戲引擎意外結束。\n是否復原上次自動儲存的專案？"

msgctxt "BrainMining.Game,Office.Popup.12.Title"
msgid "引擎崩溃报告"
msgstr "引擎崩潰報告"

msgctxt "BrainMining.Game,Office.Popup.13.Body"
msgid "关卡文件存在冲突。\n请解决冲突后重试。"
msgstr "關卡檔案存在衝突。\n請解決衝突後重試。"

msgctxt "BrainMining.Game,Office.Popup.13.Title"
msgid "版本控制 · 合并失败"
msgstr "版本控制 · 合併失敗"

msgctxt "BrainMining.Game,Office.Popup.14.Body"
msgid "正在重新连接5/5"
msgstr "正在重新連線 5/5"

msgctxt "BrainMining.Game,Office.Popup.14.Title"
msgid "连接已断开"
msgstr "連線已中斷"

msgctxt "BrainMining.Game,Office.Popup.15.Body"
msgid "我进游戏了。\n开头这里是要往哪边走？"
msgstr "我進遊戲了。\n開頭這裡是要往哪邊走？"

msgctxt "BrainMining.Game,Office.Popup.15.Title"
msgid "试玩群 · 新消息"
msgstr "試玩群 · 新訊息"

msgctxt "BrainMining.Game,Office.Popup.16.Body"
msgid "「跳过对话以后动不了了。」\n附件：录屏_02.mp4"
msgstr "「跳過對話以後動不了了。」\n附件：錄影_02.mp4"

msgctxt "BrainMining.Game,Office.Popup.16.Title"
msgid "收到新的反馈"
msgstr "收到新的回饋"

msgctxt "BrainMining.Game,Office.Popup.17.Body"
msgid "存档无法读取、角色穿墙、音效丢失。\n其中2项被标记为阻塞。"
msgstr "存檔無法讀取、角色穿牆、音效遺失。\n其中 2 項被標記為阻塞。"

msgctxt "BrainMining.Game,Office.Popup.17.Title"
msgid "问题追踪 · 新增3项"
msgstr "問題追蹤 · 新增 3 項"

msgctxt "BrainMining.Game,Office.Popup.18.Body"
msgid "跳跃参数调过了，再试下？\n我把新包传上去了。"
msgstr "跳躍參數調過了，再試一下？\n我把新版本傳上去了。"

msgctxt "BrainMining.Game,Office.Popup.18.Title"
msgid "组队群 · @你"
msgstr "組隊群 · @你"

msgctxt "BrainMining.Game,Office.Popup.19.Body"
msgid "检测到帧耗时峰值：86 ms。\n记录已保存至性能报告。"
msgstr "偵測到影格耗時峰值：86 ms。\n紀錄已儲存至效能報告。"

msgctxt "BrainMining.Game,Office.Popup.19.Title"
msgid "性能分析 · 警告"
msgstr "效能分析 · 警告"

msgctxt "BrainMining.Game,Office.Popup.20.Body"
msgid "今天修复了12个问题。\n还有3项等待确认。"
msgstr "今天修復了 12 個問題。\n還有 3 項等待確認。"

msgctxt "BrainMining.Game,Office.Popup.20.Title"
msgid "回归测试提醒"
msgstr "回歸測試提醒"

msgctxt "BrainMining.Game,Office.Popup.21.Body"
msgid "缺少资源：开始按钮音效。\n构建已终止，查看日志。"
msgstr "缺少資源：開始按鈕音效。\n建置已中止，請查看日誌。"

msgctxt "BrainMining.Game,Office.Popup.21.Title"
msgid "打包失败"
msgstr "打包失敗"

msgctxt "BrainMining.Game,Office.Popup.22.Body"
msgid "新包打开是黑屏。\n等等……好了，能进了。"
msgstr "新版本打開是黑畫面。\n等等……好了，能進了。"

msgctxt "BrainMining.Game,Office.Popup.22.Title"
msgid "测试群 · 新消息"
msgstr "測試群 · 新訊息"

msgctxt "BrainMining.Game,Office.Popup.23.Body"
msgid "作品页面尚未发布。\n待填写：操作说明、封面。"
msgstr "作品頁面尚未發布。\n待填寫：操作說明、封面。"

msgctxt "BrainMining.Game,Office.Popup.23.Title"
msgid "Game Jam · 草稿已保存"
msgstr "Game Jam · 草稿已儲存"

msgctxt "BrainMining.Game,Office.Popup.24.Body"
msgid "最后这个包谁测过了？\n没问题我就上传了。"
msgstr "最後這個版本誰測過了？\n沒問題我就上傳了。"

msgctxt "BrainMining.Game,Office.Popup.24.Title"
msgid "组队群 · @所有人"
msgstr "組隊群 · @所有人"

msgctxt "BrainMining.Game,Office.Popup.25.Body"
msgid "game_final_final.zip — 99%\n请勿关闭此窗口。"
msgstr "game_final_final.zip — 99%\n請勿關閉此視窗。"

msgctxt "BrainMining.Game,Office.Popup.25.Title"
msgid "上传中"
msgstr "上傳中"

msgctxt "BrainMining.Game,Office.Popup.26.Body"
msgid "距离截止还有10分钟。\n你的作品仍处于草稿状态。"
msgstr "距離截止還有 10 分鐘。\n你的作品仍處於草稿狀態。"

msgctxt "BrainMining.Game,Office.Popup.26.Title"
msgid "Game Jam · 提交提醒"
msgstr "Game Jam · 提交提醒"

msgctxt "BrainMining.Game,Subtitle.Cards1.001"
msgid "卡牌之间的连携可以打出强大的效果"
msgstr "卡牌之間的連攜可以打出強大的效果"

msgctxt "BrainMining.Game,Subtitle.Cards1.002"
msgid "比如元素之间的反应 涌现出新的效果"
msgstr "比如元素之間的反應，湧現出新的效果"

msgctxt "BrainMining.Game,Subtitle.Cards2.001"
msgid "这种卡牌玩法会不会太常见了呢？"
msgstr "這種卡牌玩法會不會太常見了呢？"

msgctxt "BrainMining.Game,Subtitle.CardsVictory.001"
msgid "*恭喜你获得钻机！按V可切换使用*"
msgstr "*恭喜你獲得鑽機！按 V 可切換使用*"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_00.001"
msgid "马桶堵住了然后上涌……有点味道的想法"
msgstr "馬桶堵住了然後上湧……有點味道的想法"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_01.001"
msgid "蚂蚁一直挖掘 涌现出了复杂的通路"
msgstr "螞蟻一直挖掘，湧現出了複雜的通路"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_02.001"
msgid "化学元素通过反应产生新的物质 进而形成大千世界"
msgstr "化學元素透過反應產生新的物質，進而形成大千世界"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_03.001"
msgid "肉鸽游戏很适合做连携 算是\"1+1>2\"的涌现吧"
msgstr "肉鴿遊戲很適合做連攜，算是「1+1>2」的湧現吧"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_04.001"
msgid "“1+1>2” 从这个点出发想想“涌现”吧"
msgstr "「1+1>2」，從這個點出發想想「湧現」吧"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_05.001"
msgid "把磁带扯出来……这算一种涌现吗"
msgstr "把磁帶扯出來……這算一種湧現嗎"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_06.001"
msgid "简单的几个音符能涌现出复杂的旋律"
msgstr "簡單的幾個音符能湧現出複雜的旋律"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_07.001"
msgid "回忆涌上心头……这也是一种涌现"
msgstr "回憶湧上心頭……這也是一種湧現"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_08.001"
msgid "将曼妥思投入可乐的话 可乐就会“涌现”出来"
msgstr "將曼妥思投入可樂，可樂就會「湧現」出來"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_09.001"
msgid "AI的思考不断涌现 就如同不断向下延伸的根"
msgstr "AI 的思考不斷湧現，就如同不斷向下延伸的根"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_10.001"
msgid "萤火虫的同步闪烁：随机中怎样涌现出秩序？"
msgstr "螢火蟲的同步閃爍：隨機中怎樣湧現出秩序？"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_11.001"
msgid "大量的彩带喷涌而出 也很涌现"
msgstr "大量的彩帶噴湧而出，也很湧現"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_11.002"
msgid "继续往前走走"
msgstr "繼續往前走走"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_12.001"
msgid "收集到了25个铜矿！灵感涌现！"
msgstr "收集到 25 個銅礦了！靈感湧現！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_13.001"
msgid "收集到了15个铁矿！灵感涌现！"
msgstr "收集到 15 個鐵礦了！靈感湧現！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_14.001"
msgid "收集到了10个孔雀石！灵感涌现！"
msgstr "收集到 10 個孔雀石了！靈感湧現！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_15.001"
msgid "收集到了5个钻石！灵感涌现！"
msgstr "收集到 5 個鑽石了！靈感湧現！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_16.001"
msgid "火候让食材涌现出新的香气 真香！"
msgstr "火候讓食材湧現出新的香氣，真香！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_17.001"
msgid "小小鱼缸里也有复杂生态"
msgstr "小小魚缸裡也有複雜生態"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_18.001"
msgid "钱生钱~财富涌现！"
msgstr "錢生錢～財富湧現！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_19.001"
msgid "几种滋味碰在一起 口感也有了新的层次"
msgstr "幾種滋味碰在一起，口感也有了新的層次"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_20.001"
msgid "一生二 二生三 三生万物……"
msgstr "一生二，二生三，三生萬物……"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_21.001"
msgid "车门一开 人潮就涌出来了！"
msgstr "車門一開，人潮就湧出來了！"

msgctxt "BrainMining.Game,Subtitle.CollectiblePickup_22.001"
msgid "一句话很轻 无数句话堆在一起 却能改变世界 也能压垮一个人"
msgstr "一句話很輕，無數句話堆在一起，卻能改變世界，也能壓垮一個人"

msgctxt "BrainMining.Game,Subtitle.EchoMaze.001"
msgid "通过敲击产生的声音 让前方的道路涌现出来"
msgstr "透過敲擊產生的聲音，讓前方的道路湧現出來"

msgctxt "BrainMining.Game,Subtitle.FirstCollectionHint.001"
msgid "按C打开藏品界面吧"
msgstr "按 C 開啟收藏品介面吧"

msgctxt "BrainMining.Game,Subtitle.Interaction.Book"
msgid "遇到好点子就收下来吧！"
msgstr "遇到好點子就收下來吧！"

msgctxt "BrainMining.Game,Subtitle.Interaction.BookLeft"
msgid "纸上得来终觉浅"
msgstr "紙上得來終覺淺"

msgctxt "BrainMining.Game,Subtitle.Interaction.BookRight"
msgid "绝知此事要躬行！"
msgstr "絕知此事要躬行！"

msgctxt "BrainMining.Game,Subtitle.Interaction.Computer"
msgid "时间到了，该出门干活了……"
msgstr "時間到了，該出門幹活了……"

msgctxt "BrainMining.Game,Subtitle.Interaction.Pear"
msgid "哦！美味被你发现~"
msgstr "哦！美味被你發現～"

msgctxt "BrainMining.Game,Subtitle.Interaction.Plant"
